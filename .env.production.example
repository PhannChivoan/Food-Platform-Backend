# Set these as environment variables / secrets in Northflank (never commit real values).
APP_NAME="Food Ordering"
APP_ENV=production
APP_DEBUG=false
APP_KEY=            # php artisan key:generate --show
APP_URL=https://your-api.example.com

DB_CONNECTION=mysql   # MySQL 8 required (spatial columns)
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

LOG_CHANNEL=stderr
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# your Vercel site(s), comma separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# optional: allow Vercel preview URLs
# CORS_ALLOWED_ORIGIN_PATTERNS=#^https://.*\.vercel\.app$#

# PayWay (enter in Northflank secrets only)
PAYWAY_MERCHANT_ID=
PAYWAY_API_KEY=
PAYWAY_BASE_URL=
PAYWAY_QR_TEMPLATE=template4_color
PAYWAY_CALLBACK_URL=https://your-api.example.com/api/v1/...   # same path as your local .env
PAYWAY_FRONTEND_URL=https://your-app.vercel.app
PAYWAY_VERIFY_SSL=true